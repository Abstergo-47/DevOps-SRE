    {
      "id": 18,
      "type": "timeseries",
      "title": "Memory usage by namespace (cluster)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
